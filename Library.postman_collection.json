              "pm.test(\"resbonse body to meet the schema\",function(){\r",
              "pm.response.to.have.jsonSchema(schema)\r",
              "})\r",
              "\r",
              "\r",
              "if(pm.collectionVariables.get(\"flag\")){\r",
              "    pm.execution.setNextRequest(\"Add Book\");\r",
              "}\r",
              "\r",
              ""
